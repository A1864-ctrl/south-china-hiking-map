  (1, 11, '桃花岭段野径岔路多，离线地图必须'),
  (2, 5, '发云界扎营，山顶风大'),
  (2, 6, '金顶夜间 5℃ 左右'),
  (3, 13, '竹筏与江边水汽大');

-- 帖子
INSERT INTO post (id, author_id, trail_id, poi_id, title, body, like_cnt, comment_cnt, created_at) VALUES
  (1, 1, 1, NULL, '从湖大走到梅溪湖，12.6 公里把岳麓山穿了个透',
      '早上七点从东方红广场出发，爱晚亭还没人。山顶雾散得慢，等到九点才看到湘江。桃花岭那段野径要跟丝带，别乱走。', 12, 2, '2026-11-05 09:20:00'),
  (2, 2, 3, NULL, '漓江这段建议坐竹筏，不要只走路',
      '杨堤到兴坪走了 4 小时，黄布倒影那段光线最好在下午四点后。', 8, 1, '2026-11-05 16:40:00'),
  (3, 3, 2, NULL, '武功山两天，金顶日出值得熬夜',
      '发云界扎营，夜里风大，帐篷要选抗风的。第二天四点起，五点登顶。', 21, 3, '2026-11-06 06:10:00'),
  (4, 4, NULL, 1, '广州塔日落机位实测',
      '二层平台西北角，太阳落在 253°，把塔放在画面右三分之一。', 5, 0, '2026-11-06 18:35:00');

