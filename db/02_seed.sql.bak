-- 景点
INSERT INTO poi (id, name, city, district, category, heat, ticket, suggest_hrs, geom, intro) VALUES
  (1, '广州塔',       '广州', '海珠区', '地标', 98, '¥150', '2-3 小时', ST_GeomFromText('POINT(113.324500 23.106600)', 4326), '珠江边的城市地标，日落与夜景的最佳机位在二层平台。'),
  (2, '漓江·杨堤至兴坪', '桂林', '阳朔县', '江河', 96, '¥215', '4-6 小时', ST_GeomFromText('POINT(110.531000 25.018000)', 4326), '漓江最精华的 20 公里水路，九马画山、黄布倒影都在这一段。'),
  (3, '张家界国家森林公园', '张家界', '武陵源区', '峰林', 97, '¥228', '1-2 天', ST_GeomFromText('POINT(110.479000 29.325000)', 4326), '袁家界哈利路亚山与金鞭溪，砂岩峰林世界罕见。'),
  (4, '岳麓山',       '长沙', '岳麓区', '城市山', 92, '免费', '半天', ST_GeomFromText('POINT(112.933000 28.184000)', 4326), '爱晚亭、麓山寺、云麓宫一路串起来，秋天红叶最好看。'),
  (5, '巽寮湾',       '惠州', '惠东县', '海岸', 90, '免费', '半天', ST_GeomFromText('POINT(114.735000 22.727000)', 4326), '细沙滩与渔港，适合清晨与日落两个时段。'),
  (6, '莽山·五指峰',  '郴州', '宜章县', '山峰', 88, '¥120', '1 天', ST_GeomFromText('POINT(112.891000 25.031000)', 4326), '南岭山脉保存最完整的原始森林之一，云海与冰挂都出名。');

-- 路线（几何简化示意，仅用于演示空间查询）
INSERT INTO trail
  (id, name, province, city, terrain, level, days, distance_km, climb_m, season, loop_type,
   geom, start_pt, min_lat, max_lat, min_lng, max_lng, desc_text)
VALUES
  (1, '岳麓山·桃花岭穿越', '湖南', '长沙', '城市山', 1, 1, 12.60, 300, '全年', 0,
   ST_GeomFromText('LINESTRING(112.938400 28.183000,112.933500 28.184100,112.936000 28.185000,112.932000 28.187000,112.918000 28.187000,112.905000 28.186000,112.887830 28.191020)', 4326),
   ST_GeomFromText('POINT(112.938400 28.183000)', 4326),
   28.183000, 28.191020, 112.887830, 112.938400,
   '起点湖南大学东方红广场，终点梅溪湖，中间翻越岳麓山主峰与桃花岭。名字里的两座山是途经段，不是起终点。'),

  (2, '武功山·金顶穿越', '江西', '萍乡', '高山草甸', 3, 2, 26.00, 1590, '9-11月', 0,
   ST_GeomFromText('LINESTRING(114.190000 27.490000,114.183000 27.478000,114.176000 27.466000,114.173000 27.456000)', 4326),
   ST_GeomFromText('POINT(114.190000 27.490000)', 4326),
   27.456000, 27.490000, 114.173000, 114.190000,
   '两天重装，金顶看日出，发云界扎营。'),

  (3, '漓江·杨堤至兴坪', '广西', '桂林', '喀斯特田园', 1, 1, 20.00, 210, '全年', 0,
   ST_GeomFromText('LINESTRING(110.531000 25.018000,110.520000 25.010000,110.505000 24.995000,110.492000 24.980000)', 4326),
   ST_GeomFromText('POINT(110.531000 25.018000)', 4326),
   24.980000, 25.018000, 110.492000, 110.531000,
   '沿江步道与竹筏并行的经典段，黄布倒影在兴坪前 3 公里。');

